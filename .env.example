# -------------------------------------------------------------
# JobIntel Environment Configuration
# -------------------------------------------------------------

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=JobIntel
APP_VERSION=0.1.0
SECRET_KEY=change-this-secret-key-in-production-jobintel-2025

# Database Configuration (PostgreSQL primary; fallback to SQLite for quick local test)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/jobintel
DATABASE_URL_TEST=sqlite:///./test_jobintel.db
DB_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
# The web UI is served by the API itself (same origin), so CORS only matters for other front-ends.
CORS_ORIGINS=["http://127.0.0.1:8000", "http://localhost:8000"]

# Job Ingestion Data Sources
# Primary Source: Jobvetta API (https://jobvetta.com)
JOBVETTA_API_KEY=your_jobvetta_api_key_here
JOBVETTA_BASE_URL=https://api.jobvetta.com/v1
JOBVETTA_DAILY_REQUEST_LIMIT=50
JOBVETTA_PAGE_SIZE=10

# Secondary Source (Future): Adzuna API
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
ADZUNA_COUNTRY=in

# NLP & ML Configuration
SKILLS_TAXONOMY_PATH=nlp/dictionaries/skills_taxonomy.json

# Recommender Weights (Hybrid Strategy)
WEIGHT_CONTENT=0.30
WEIGHT_SKILL=0.35
WEIGHT_PREFERENCE=0.20
WEIGHT_BEHAVIOR=0.10
WEIGHT_POPULARITY=0.05

# Live ingestion
ADZUNA_APP_KEY=your_adzuna_app_key_here
ADZUNA_DAILY_CALL_BUDGET=200     # per run; Adzuna's published limit is 250 calls/day, 25/minute
STALE_AFTER_DAYS=30              # jobs not re-sighted for this long drop out of the feed (0 = never)

# Accounts: email + password (scrypt hashes) and signed 7-day sessions
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REQUIRE_USER_TOKEN=true
# SECRET_KEY signs the sessions: use a long random value (the app refuses to start outside development with the placeholder)
